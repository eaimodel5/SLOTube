rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitive Definition
    function isValidId(id) { 
        return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // ==========================================
    // DEV ONLY: OPEN ACCESS
    // For MVP/Demo purposes, we allow global read/write.
    // ==========================================
    function isAllowed() { return true; } 

    // ==========================================
    // PRODUCTION TEMPLATE (commented out)
    // ==========================================
    // function isAuthenticated() { return request.auth != null; }
    // function isAdmin() { 
    //    return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    // }
    // 
    // Then in the rules:
    // allow update: if isAdmin() && ...
    // allow create: if isAuthenticated() && ...
    // ==========================================
    
    function isValidVideo(data) {
        return data.keys().hasAll(['id', 'title', 'status', 'origin'])
            && data.id is string
            && data.title is string
            && data.status is string && data.status.matches('^(pending|approved|rejected)$');
    }

    match /databaas_codes/{codeId} {
      allow read, write: if isAllowed();
    }
    
    match /system_config/{configId} {
      allow read, write: if isAllowed();
    }
    
    match /videos/{videoId} {
      allow read: if isAllowed();
      
      allow create: if isAllowed() 
                    && isValidId(videoId)
                    && isValidVideo(incoming());
                    
      allow update: if isAllowed()
                    && isValidVideo(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'goalSnapshot', 'matchScore', 'matchConfidence', 
                      'matchReason', 'matchEvidence', 'matchPenalties', 'aiAssessment', 
                      'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy', 'rejectReason',
                      'assessedGoals', 'addedAt', 'addedBy', 'sourceType', 'provider', 'videoId', 'title',
                      'channelTitle', 'description', 'duration', 'publishedAt', 'thumbnailUrl',
                      'sourceId', 'sourceName', 'sourceUrl', 'canonicalUrl', 'thumbnailStatus', 'goalId'
                    ]);
                    
      allow delete: if isAllowed();
    }
  }
}
